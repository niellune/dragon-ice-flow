{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/run-ps.sh .claude/hooks/gate-check.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/run-ps.sh .claude/hooks/budget-check.ps1"
          },
          {
            "type": "command",
            "command": "sh .claude/run-ps.sh .claude/scripts/unslop/unslop.ps1 -Hook"
          }
        ]
      }
    ]
  }
}
